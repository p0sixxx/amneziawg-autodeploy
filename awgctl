#!/usr/bin/env bash
# awgctl — установка и удобное управление AmneziaWG-сервером.
#
# Движок — bivlked/amneziawg-installer (MIT), закреплённая версия, проверка SHA256; его код не меняется.
# awgctl добавляет: проверки сервера и сети, проверку блокировки IP в РФ (check-host.net),
# случайный UDP-порт, безопасные флаги установки, продолжение после перезагрузок и команды
# управления пользователями в стиле `vpn` из 3x-ui-autodeploy.
#
# Установка на чистом Ubuntu 24.04 / Debian 13 (KVM):
#   curl -fsSLo /root/awgctl https://raw.githubusercontent.com/p0sixxx/amneziawg-autodeploy/main/awgctl
#   bash /root/awgctl install --dry-run     # только план
#   bash /root/awgctl install               # установка; дальше команда доступна как awgctl
# shellcheck disable=SC2015  # ok/warn/fail всегда возвращают 0
set -Eeuo pipefail

AD_VERSION="2.1.0"
AD_REPO_RAW="${AD_REPO_RAW:-https://raw.githubusercontent.com/p0sixxx/amneziawg-autodeploy}"
AD_REF="${AD_REF:-main}"
# Движок: релиз bivlked/amneziawg-installer. Смена версии — только после аудита (AUDIT.md),
# SHA256 — файла install_amneziawg.sh из релиза (совпадает с файлом под тегом).
ENGINE_VER="6.2.1"
ENGINE_URL="https://github.com/bivlked/amneziawg-installer/releases/download/v${ENGINE_VER}/install_amneziawg.sh"
ENGINE_SHA256="75940a6c92c3734f7f8bc43d9f499b572b430144c79b7342a7bdc6f21969cf91"

# Дополнения (ставятся по желанию в конце установки или командами awgctl adblock / awgctl bot)
AWGRAM_VER="v0.13.2"   # https://github.com/ekuraev/awgram
AWGRAM_SETUP_SHA256="a00410bee82a09aaaf143dec7e1e35f3bb3b6795a20f3908d2a3fc88580df14e"
BLOCKY_VER="0.34.0"    # https://github.com/0xERR0R/blocky
BLOCKY_SHA256_X86_64="17b03f892346a160e9faf974ce68baae85fa4f2a94d7bf8ea52592a94be5eeb4"
BLOCKY_SHA256_ARM64="1a07aa52b127d75d15584706c76843b9fa3706be133b0d7b96b2ca65ba4f561f"
# конфиг Blocky и списки — из github.com/Cueuler/amneziawg_dns_adblock (закреплённый коммит)
ADBLOCK_REPO="https://raw.githubusercontent.com/Cueuler/amneziawg_dns_adblock/3db27d269031c4c7a33ec8968316bf0e2c70a004"
ADBLOCK_FILES="config.yml:b2c8fef5cbc727390df9c2088207154a7bc502d54ce7e36533c4e0489c540e26 custom-deny.txt:a0f2a9566b0fb28bfe2aa8832ab15df0d6355e0edb69be72e23b4a6751274848 blocky.service:7845adb43b3e6823845e10f21a88ed54fa3993bb9fe7a57aed64539149dd4f1a"

AD_DIR=/var/lib/awgctl
AD_STATE="$AD_DIR/state.env"
AD_LOG=/var/log/awgctl.log
AD_BIN=/usr/local/sbin/awgctl
AD_UNIT=/etc/systemd/system/awgctl-resume.service
AWG_DIR=/root/awg
SERVER_CONF=/etc/amnezia/amneziawg/awg0.conf
OFF_LIST="$AD_DIR/disabled"
CH=https://check-host.net

# ------------------------------------------------------------------ вывод
if [[ -t 1 ]]; then C_G=$'\e[32m'; C_Y=$'\e[33m'; C_R=$'\e[31m'; C_B=$'\e[1m'; C_0=$'\e[0m'; else C_G=""; C_Y=""; C_R=""; C_B=""; C_0=""; fi
log()  { printf '%s\n' "$*"; printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$AD_LOG" 2>/dev/null || true; }
hdr()  { log ""; log "${C_B}==> $*${C_0}"; }
ok()   { log "    ${C_G}[OK]${C_0} $*"; }
warn() { log "    ${C_Y}[!!]${C_0} $*"; WARNS=$((WARNS + 1)); }
fail() { log "    ${C_R}[FAIL]${C_0} $*"; FAILS=$((FAILS + 1)); }
die()  { printf '%s\n' "" "${C_R}[СТОП]${C_0} $*" >&2; printf '%s %s\n' "$(date '+%F %T')" "[СТОП] $*" >>"$AD_LOG" 2>/dev/null || true; exit 1; }
WARNS=0; FAILS=0
trap 'rc=$?; [[ $rc -ne 0 ]] && printf "Ошибка в строке %s (код %s). Лог: %s\n" "$LINENO" "$rc" "$AD_LOG" >&2' ERR

# ------------------------------------------------------------------ аргументы
CMD=""; POS=(); DRY_RUN=0; AUTO_YES=0; PORT="${PORT:-}"; MOBILE="${MOBILE:-0}"; PROTOCOL="${PROTOCOL:-3.1}"
ENDPOINT="${ENDPOINT:-}"; CLIENTS="${CLIENTS:-}"; ALLOW_BLOCKED="${ALLOW_BLOCKED:-0}"; SKIP_EXT="${SKIP_EXTERNAL_CHECK:-0}"
SRV_NAME="${SERVER_NAME:-}"; WANT_ADBLOCK=""; WANT_BOT=""; TG_TOKEN="${AWGRAM_TOKEN:-}"; TG_ADMINS=""; DAYS=""; PSK=0; KEEP_PKGS="${KEEP_PACKAGES:-0}"; KEEP_IPV6="${KEEP_IPV6:-0}"; EXTRA=()
if [[ "${1:-}" == engine ]]; then CMD=engine; shift; EXTRA=("$@"); set --; fi   # всё дальше — как есть в manage_amneziawg.sh
while (($#)); do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        -y|--yes|--non-interactive) AUTO_YES=1 ;;
        --port=*) PORT=${1#*=} ;;
        --mobile) MOBILE=1 ;;
        --protocol=*) PROTOCOL=${1#*=} ;;
        --endpoint=*) ENDPOINT=${1#*=} ;;
        --clients=*) CLIENTS=${1#*=} ;;
        --name=*) SRV_NAME=${1#*=} ;;
        --adblock) WANT_ADBLOCK=1 ;;
        --bot) WANT_BOT=1 ;;
        --tg-admins=*) TG_ADMINS=${1#*=}; WANT_BOT=1 ;;
        --no-extras) WANT_ADBLOCK=0; WANT_BOT=0 ;;
        --allow-blocked-ip) ALLOW_BLOCKED=1 ;;
        --skip-external-check) SKIP_EXT=1 ;;
        --days=*) DAYS=${1#*=} ;;
        --days) shift; DAYS=${1:-} ;;
        --psk) PSK=1 ;;
        --keep-packages) KEEP_PKGS=1 ;;
        --keep-ipv6) KEEP_IPV6=1 ;;
        -h|--help) CMD=help ;;
        --) shift; EXTRA=("$@"); break ;;
        -*) die "Неизвестный параметр: $1 (справка: awgctl help)" ;;
        *) if [[ -z "$CMD" ]]; then CMD=$1; else POS+=("$1"); fi ;;
    esac
    shift
done
CMD=${CMD:-help}

usage() {
    cat <<'HELP'
awgctl — AmneziaWG: установка и управление пользователями

Установка
  awgctl install [--dry-run] [--name="Имя"] [--port=N | --mobile] [--protocol=3.1|2.0] [--clients=a,b]
                 [--endpoint=АДРЕС] [--keep-packages] [--keep-ipv6] [--allow-blocked-ip] [--skip-external-check]
                 [--adblock] [--bot --tg-admins=ID] [--no-extras]
                 случайный порт, IPv6 хоста выключен, лишние пакеты удаляются; в начале спросит
                 про блокировщик рекламы и Telegram-бот (или задай флагами)
                 [-- флаги install_amneziawg.sh]
  awgctl status                  ход установки (после перезагрузок)
  awgctl resume                  продолжить прерванную установку

Пользователи
  awgctl add <имя> [--days N] [--psk]   новый пользователь: QR, ссылка vpn:// и файл .conf
  awgctl list                           все: IP, вкл/выкл, трафик, последний вход, срок
  awgctl show <имя>                     QR + ссылка vpn:// + путь к .conf
  awgctl qr <имя>                       QR для приложения AmneziaWG
  awgctl link <имя>                     ссылка vpn:// (Amnezia VPN, AmneziaWG)
  awgctl conf <имя>                     текст конфига (вставить в «Добавить туннель»)
  awgctl renew <имя> <дней|0>           продлить на N дней от сегодня (0 — бессрочно)
  awgctl off <имя> / awgctl on <имя>    временно отключить / включить (ключи сохраняются)
  awgctl del <имя>                      удалить

Сервер
  awgctl check                   проверка: сервис, порт, NAT, ufw, IP из России (check-host.net)
  awgctl backup | restore [файл] бэкап ключей и клиентов / восстановление
  awgctl uninstall               удалить AmneziaWG и awgctl

Дополнения
  awgctl adblock [on|off|status] блокировка рекламы и трекеров по DNS (Blocky + списки Hagezi)
  awgctl bot                     Telegram-бот awgram: пользователи с телефона
  awgctl engine <команда …>      любая команда manage_amneziawg.sh (diagnose, stats, regen…)
  awgctl help
HELP
}
need_root() { [[ $EUID -eq 0 ]] || die "Запусти от root (sudo -i)."; }

ask() { # ask "вопрос" → 0 = да
    [[ $AUTO_YES -eq 1 ]] && return 0
    [[ -r /dev/tty ]] || return 1
    local a; read -rp "    $1 [y/N] " a </dev/tty || return 1
    [[ "$a" =~ ^([Yy]|[Yy]es|да|Да|д)$ ]]
}

# ------------------------------------------------------------------ check-host.net
ch_get() { curl -fsS --max-time 20 -H 'Accept: application/json' "$CH$1"; }
ch_nodes() { # до 3 узлов из России и до 3 из Европы
    local j; j=$(ch_get /nodes/hosts) || return 1
    jq -r '[.nodes | to_entries[] | select(.value.location[0] == "ru")] | .[:3][] | .key' <<<"$j"
    jq -r '[.nodes | to_entries[] | select(.value.location[0] as $c
            | ["de","nl","fi","fr","pl","se","gb","uk","ch","at","cz","lt","lv","ee"] | index($c))] | .[:3][] | .key' <<<"$j"
}
probe() { # probe <ip> <port...> → «<port> <ок_РФ>/<всего_РФ> <ок_Европа>/<всего_Европа>» или «<port> ?»
    local ip=$1; shift
    local nodes=() q="" n p id res pairs=()
    mapfile -t nodes < <(ch_nodes 2>/dev/null || true)
    ((${#nodes[@]} > 0)) || return 1
    for n in "${nodes[@]}"; do q+="&node=${n}"; done
    for p in "$@"; do
        id=$(ch_get "/check-tcp?host=${ip}:${p}${q}" 2>/dev/null | jq -r '.request_id // empty' 2>/dev/null || true)
        pairs+=("${p}:${id}")
    done
    sleep 4
    for n in "${pairs[@]}"; do
        p=${n%%:*}; id=${n#*:}
        if [[ -z "$id" ]]; then echo "$p ?"; continue; fi
        res=""
        for _ in $(seq 1 12); do
            res=$(ch_get "/check-result/${id}" 2>/dev/null || true)
            [[ -n "$res" ]] && jq -e 'type == "object" and ([.[] | select(. == null)] | length == 0)' >/dev/null 2>&1 <<<"$res" && break
            sleep 2
        done
        [[ -n "$res" ]] || res='{}'
        # «connection refused» тоже значит, что IP достижим (порт просто закрыт)
        jq -r --arg p "$p" '[to_entries[] | {ru: (.key | startswith("ru")),
              ok: ((.value // [])[0] | if type == "object" then (has("time") or ((.error // "") | test("refused"; "i"))) else false end)}] as $a
            | "\($p) \([$a[] | select(.ru and .ok)] | length)/\([$a[] | select(.ru)] | length) \([$a[] | select((.ru | not) and .ok)] | length)/\([$a[] | select(.ru | not)] | length)"' \
            <<<"$res" 2>/dev/null || echo "$p ?"
    done
}

# ------------------------------------------------------------------ сеть сервера
detect_ip() {
    local u ip
    for u in https://api4.ipify.org https://ipv4.icanhazip.com https://4.ident.me https://check-host.net/ip; do
        ip=$(curl -4 -fs --max-time 5 "$u" | tr -d '[:space:]"') || continue
        [[ "$ip" =~ ^[0-9]+(\.[0-9]+){3}$ ]] && { echo "$ip"; return; }
    done
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}'
}
ssh_port() {
    local p
    p=$(ss -Hltnp 2>/dev/null | awk '/"sshd"/ {sub(/.*:/, "", $4); print $4; exit}')
    echo "${p:-22}"
}
udp_busy() { [[ -n "$(ss -Hlun "sport = :$1" 2>/dev/null)" ]]; }
# порты, которые часто заняты или выглядят подозрительно для DPI (WireGuard, OpenVPN, IPsec и т. п.)
BAD_PORTS=" 500 1194 1701 4500 51820 51821 39743 3478 5060 "
random_port() {
    local p
    for _ in $(seq 1 200); do
        p=$(( 20000 + $(od -An -tu4 -N4 /dev/urandom | tr -d ' ') % 40000 ))
        [[ "$BAD_PORTS" == *" $p "* ]] && continue
        udp_busy "$p" && continue
        echo "$p"; return 0
    done
    return 1
}

# скачать файл репозитория; для приватного репозитория — GH_TOKEN (fine-grained, только Contents: read)
repo_get() { # repo_get <путь в репо> <куда>
    local auth=()
    [[ -n "${GH_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer ${GH_TOKEN}")
    curl -fsSL --max-time 120 "${auth[@]}" -o "$2" "$AD_REPO_RAW/$AD_REF/$1"
}

# ------------------------------------------------------------------ состояние
state_save() {
    mkdir -p "$AD_DIR"; chmod 700 "$AD_DIR"
    {
        printf 'PORT=%q\nPROTOCOL=%q\nENDPOINT=%q\nCLIENTS=%q\nMOBILE=%q\nKEEP_PKGS=%q\nKEEP_IPV6=%q\nSRV_NAME=%q\nWANT_ADBLOCK=%q\nWANT_BOT=%q\nTG_TOKEN=%q\nTG_ADMINS=%q\n' "$PORT" "$PROTOCOL" "$ENDPOINT" "$CLIENTS" "$MOBILE" "$KEEP_PKGS" "$KEEP_IPV6" "$SRV_NAME" "$WANT_ADBLOCK" "$WANT_BOT" "$TG_TOKEN" "$TG_ADMINS"
        # пустой массив: printf '%q ' без аргументов печатает '' — это сломало бы установщик
        printf 'EXTRA=('; ((${#EXTRA[@]})) && printf '%q ' "${EXTRA[@]}"; printf ')\n'
        printf 'PUBLIC_IP=%q\n' "${PUBLIC_IP:-}"
    } >"$AD_STATE.tmp"
    chmod 600 "$AD_STATE.tmp"; mv -f "$AD_STATE.tmp" "$AD_STATE"
}
state_load() {
    [[ -f "$AD_STATE" ]] || return 1
    # файл пишет только этот скрипт (printf %q), права 600, владелец root
    [[ "$(stat -c '%U %a' "$AD_STATE")" == "root 600" ]] || die "$AD_STATE: неверные права/владелец — не загружаю."
    # shellcheck disable=SC1090
    source "$AD_STATE"
    # файлы состояния awgctl < 2.1 содержали EXTRA=('') — пустые аргументы выбрасываем
    local a clean=()
    for a in "${EXTRA[@]+"${EXTRA[@]}"}"; do [[ -n "$a" ]] && clean+=("$a"); done
    EXTRA=("${clean[@]+"${clean[@]}"}")
}

self_install() { # копия обёртки в /usr/local/sbin, чтобы продолжить после перезагрузки
    local src
    src=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)
    if [[ -f "$src" && "$src" != "$AD_BIN" ]]; then
        install -m 700 "$src" "$AD_BIN"
    elif [[ ! -x "$AD_BIN" ]]; then
        repo_get awgctl "$AD_BIN.new" && chmod 700 "$AD_BIN.new" && mv -f "$AD_BIN.new" "$AD_BIN" \
            || die "Не удалось сохранить обёртку в $AD_BIN"
    fi
}
resume_unit_on() {
    cat >"$AD_UNIT" <<EOF
[Unit]
Description=awgctl: продолжить установку после перезагрузки
After=network-online.target
Wants=network-online.target
ConditionPathExists=$AD_STATE

[Service]
Type=oneshot
ExecStart=$AD_BIN resume
StandardOutput=append:$AD_LOG
StandardError=append:$AD_LOG
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable awgctl-resume.service >/dev/null 2>&1
}
resume_unit_off() {
    systemctl disable awgctl-resume.service >/dev/null 2>&1 || true
    rm -f "$AD_UNIT"; systemctl daemon-reload || true
}

# ------------------------------------------------------------------ проверки до установки
preflight() {
    hdr "Проверка сервера"
    local id ver arch virt ram disk
    # shellcheck disable=SC1091
    . /etc/os-release
    id=$ID; ver=$VERSION_ID
    case "$id:$ver" in
        ubuntu:24.04|ubuntu:26.04|debian:13) ok "ОС: $PRETTY_NAME" ;;
        ubuntu:22.04|ubuntu:25.*|debian:12) warn "ОС $PRETTY_NAME: установщик её поддерживает, но обёртка проверена на Ubuntu 24.04 и Debian 13" ;;
        *) die "ОС $PRETTY_NAME не поддерживается. Нужна Ubuntu 24.04 LTS или Debian 13." ;;
    esac
    arch=$(uname -m)
    case "$arch" in
        x86_64|aarch64) ok "Архитектура: $arch" ;;
        *) die "Архитектура $arch не поддерживается (нужна x86_64 или arm64)." ;;
    esac
    virt=$(systemd-detect-virt 2>/dev/null || echo none)
    case "$virt" in
        lxc|openvz|docker|podman|wsl|systemd-nspawn) die "Виртуализация $virt — это контейнер: модуль ядра не поставить. Нужен KVM/VMware/Hyper-V/выделенный сервер." ;;
        *) ok "Виртуализация: $virt" ;;
    esac
    ok "Ядро: $(uname -r)"
    if [[ "$PROTOCOL" == "3.1" ]] && ! printf '%s\n%s\n' 6.7 "$(uname -r | cut -d- -f1)" | sort -VC; then
        warn "Ядро старее 6.7: AmneziaWG 3.1 здесь не поднять, установщик поставит 2.0 (или обнови ядро)"
    fi
    ram=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
    ((ram >= 450)) && ok "RAM: ${ram} МБ" || die "RAM ${ram} МБ — мало (нужно от 512 МБ: сборка модуля через DKMS)."
    disk=$(df -Pm / | awk 'NR==2 {print $4}')
    ((disk >= 1500)) && ok "Свободно на диске: ${disk} МБ" || die "Свободно ${disk} МБ — нужно хотя бы 1,5 ГБ (заголовки ядра + DKMS)."
    [[ -c /dev/net/tun ]] && ok "/dev/net/tun есть (нужен только запасному amneziawg-go)" || warn "Нет /dev/net/tun: запасной вариант amneziawg-go не заработает (модулю ядра не нужен)"

    hdr "Конфликты"
    if ip -o link show type wireguard 2>/dev/null | grep -q .; then
        warn "Есть интерфейс WireGuard: $(ip -o link show type wireguard | awk -F': ' '{print $2}' | tr '\n' ' ')— проверь, что подсети и порты не пересекаются"
    else ok "WireGuard-интерфейсов нет"; fi
    if command -v docker >/dev/null 2>&1 && systemctl is-active --quiet docker 2>/dev/null; then
        warn "Работает Docker: он сам правит iptables/FORWARD — проверь доступ клиентов после установки"
    else ok "Docker не запущен"; fi
    if [[ -f "$AWG_DIR/setup_state" ]]; then
        warn "Найдена начатая/выполненная установка AmneziaWG ($AWG_DIR/setup_state) — установщик продолжит её, ключи и клиенты сохранятся"
    fi
    if systemctl is-active --quiet x-ui 2>/dev/null; then
        warn "На сервере работает 3x-ui: AWG встанет рядом, но порт 443/udp может быть занят Hysteria2"
    fi

    hdr "Сеть"
    getent hosts github.com >/dev/null || die "DNS не работает (не резолвится github.com)."
    ok "DNS работает"
    local u
    for u in https://raw.githubusercontent.com https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu/ "$CH"; do
        curl -fsS -o /dev/null --max-time 15 "$u" 2>/dev/null || curl -sS -o /dev/null --max-time 15 "$u" 2>/dev/null \
            || { [[ "$u" == "$CH" ]] && { warn "Нет доступа к check-host.net — внешняя проверка будет пропущена"; SKIP_EXT=1; continue; }; die "Нет доступа к $u"; }
    done
    ok "Доступны GitHub и PPA Amnezia"
    PUBLIC_IP=$(detect_ip)
    [[ -n "$PUBLIC_IP" ]] || die "Не удалось определить публичный IPv4."
    local on_if=""
    for _ in 1 2 3 4 5; do   # сразу после загрузки DHCP может ещё переполучать адрес
        ip -4 -o addr show scope global | grep -qwF "$PUBLIC_IP" && { on_if=1; break; }
        sleep 2
    done
    if [[ -n "$on_if" ]]; then ok "Публичный IP: $PUBLIC_IP (на интерфейсе сервера)"
    else warn "Публичный IP $PUBLIC_IP не на интерфейсе — сервер за NAT: UDP-порт должен быть проброшен хостером"; fi
    if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" == yes ]]; then ok "Время синхронизировано (NTP)"
    else warn "Время не синхронизировано по NTP (timedatectl) — для AWG не критично, но проверь"; fi

    hdr "Порт AmneziaWG"
    if [[ -n "$PORT" ]]; then
        [[ "$PORT" =~ ^[0-9]+$ ]] && ((PORT >= 1 && PORT <= 65535)) || die "PORT=$PORT — не порт."
        udp_busy "$PORT" && ! awg show awg0 listen-port 2>/dev/null | grep -qx "$PORT" && die "UDP-порт $PORT занят: $(ss -Hlunp "sport = :$PORT" | head -1)"
        ok "Порт задан: ${PORT}/udp"
    elif [[ "$MOBILE" == 1 ]]; then
        udp_busy 443 && die "443/udp занят (Hysteria2/HTTP3?) — для --mobile освободи его или задай --port=N"
        PORT=443; ok "Порт 443/udp (--mobile: мобильные операторы реже режут его как QUIC)"
    else
        PORT=$(random_port) || die "Не нашёл свободный UDP-порт"
        ok "Случайный порт: ${PORT}/udp (не стандартный 39743 — по нему легко найти сервер)"
    fi

    external_check
}

external_check() { # не заблокирован ли IP в России
    hdr "Доступность IP из России и Европы (check-host.net)"
    if [[ "$SKIP_EXT" == 1 ]]; then warn "Внешняя проверка пропущена"; return 0; fi
    local sp out ru w
    sp=$(ssh_port)
    if ! out=$(probe "$PUBLIC_IP" "$sp"); then warn "check-host.net не ответил — проверка пропущена"; return 0; fi
    read -r _ ru w <<<"$out"
    if [[ "$ru" == "?" || -z "${w:-}" ]]; then warn "Проверка не выполнилась (check-host.net)"; return 0; fi
    local ru_ok=${ru%/*} ru_all=${ru#*/} w_ok=${w%/*}
    if ((ru_ok > 0)); then
        ok "IP доступен из России (${ru}) и Европы (${w})"
    elif ((w_ok > 0 && ru_all > 0)); then
        fail "IP $PUBLIC_IP недоступен из России (${ru}), из Европы доступен (${w}) — похоже, он уже в блоке РКН"
        if [[ "$CMD" == install && "$ALLOW_BLOCKED" != 1 ]]; then
            die "Ставить VPN на заблокированный IP бессмысленно. Смени IP/сервер или запусти с --allow-blocked-ip."
        fi
    else
        warn "IP не отвечает ни из России, ни из Европы (${ru} / ${w}) на ${sp}/tcp — фаервол хостера? Сама установка не помешает"
    fi
}

# ------------------------------------------------------------------ установщик
fetch_installer() { # движок bivlked из релиза, проверка SHA256
    local f="$AD_DIR/install_amneziawg.sh" got
    mkdir -p "$AD_DIR"; chmod 700 "$AD_DIR"
    curl -fsSL --max-time 120 -o "$f.new" "$ENGINE_URL" || die "Не удалось скачать $ENGINE_URL"
    got=$(sha256sum "$f.new" | awk '{print $1}')
    if [[ "$got" != "$ENGINE_SHA256" ]]; then
        rm -f "$f.new"
        die "SHA256 install_amneziawg.sh v${ENGINE_VER} не совпал (ожидался $ENGINE_SHA256, получен $got). Файл мог быть подменён."
    fi
    chmod 700 "$f.new"; mv -f "$f.new" "$f"
    log "    install_amneziawg.sh v${ENGINE_VER}: SHA256 совпал"
}

installer_args() {
    # как рекомендует автор движка для однозадачного VPS (1 ядро / 1 ГБ): IPv6 на хосте выключен,
    # лишние службы (snapd, packagekit, modemmanager, udisks2, unattended-upgrades…) удаляются.
    INST_ARGS=(--yes --no-prebuilt --route-all --isolation=on "--port=$PORT" "--protocol=$PROTOCOL")
    [[ "$KEEP_PKGS" == 1 ]] && INST_ARGS+=(--keep-packages)
    if [[ "$KEEP_IPV6" == 1 ]]; then INST_ARGS+=(--allow-ipv6); else INST_ARGS+=(--disallow-ipv6); fi
    [[ "$MOBILE" == 1 ]] && INST_ARGS+=(--preset=mobile)
    [[ -n "$ENDPOINT" ]] && INST_ARGS+=("--endpoint=$ENDPOINT")
    [[ -n "$SRV_NAME" ]] && INST_ARGS+=("--server-name=$SRV_NAME")
    INST_ARGS+=("${EXTRA[@]+"${EXTRA[@]}"}")
}

run_installer() { # 0 — установка завершена; 2 — ушёл в перезагрузку
    installer_args
    hdr "Запуск install_amneziawg.sh ${INST_ARGS[*]}"
    local rc=0 before after lf="$AWG_DIR/install_amneziawg.log"
    before=$(grep -c 'ТРЕБУЕТСЯ ПЕРЕЗАГРУЗКА' "$lf" 2>/dev/null || true)
    # AWG_BRANCH в окружении отключил бы проверку SHA256 скриптов движка (см. AUDIT.md) — убираем
    env -u AWG_BRANCH -u AWG_ALLOW_UNVERIFIED -u AWG_FORCE_REINSTALL bash "$AD_DIR/install_amneziawg.sh" "${INST_ARGS[@]}" || rc=$?
    if [[ "$(cat "$AWG_DIR/setup_state" 2>/dev/null)" == "99" ]]; then
        return 0
    fi
    # перезагрузку просил именно ЭТОТ запуск (новая строка в логе), а не прошлый
    after=$(grep -c 'ТРЕБУЕТСЯ ПЕРЕЗАГРУЗКА' "$lf" 2>/dev/null || true)
    if [[ $rc -ne 0 ]] && (( ${after:-0} > ${before:-0} )); then
        return 2
    fi
    return "$rc"
}

manage() { bash "$AWG_DIR/manage_amneziawg.sh" "$@"; }

setup_clients() {
    [[ -n "$CLIENTS" ]] || return 0
    hdr "Клиенты: $CLIENTS"
    local c names=()
    IFS=',' read -ra names <<<"$CLIENTS"
    for c in "${names[@]}"; do
        c=${c//[[:space:]]/}
        [[ "$c" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { warn "Имя клиента «$c» пропущено (латиница, цифры, _ и -)"; continue; }
        if [[ -f "$AWG_DIR/$c.conf" ]]; then ok "$c уже есть"; continue; fi
        manage --yes add "$c" >/dev/null && ok "$c добавлен" || warn "Не удалось добавить $c (manage_amneziawg.sh add $c)"
    done
    for c in my_phone my_laptop; do   # клиенты по умолчанию установщика — убираем, если их не просили
        [[ ",${CLIENTS// /}," == *",$c,"* ]] && continue
        [[ -f "$AWG_DIR/$c.conf" ]] && manage --yes remove "$c" >/dev/null 2>&1 && ok "Клиент по умолчанию $c удалён"
    done
}

# ------------------------------------------------------------------ проверка после установки
post_check() {
    WARNS=0; FAILS=0
    hdr "Проверка AmneziaWG"
    [[ -f "$AD_STATE" ]] && state_load || true
    local lp
    systemctl is-active --quiet awg-quick@awg0 && ok "Сервис awg-quick@awg0 работает" || fail "Сервис awg-quick@awg0 не запущен (journalctl -u awg-quick@awg0)"
    lp=$(awg show awg0 listen-port 2>/dev/null || true)
    if [[ -n "$lp" ]]; then
        ok "Интерфейс awg0 поднят, порт ${lp}/udp"
        [[ -z "${PORT:-}" || "$lp" == "$PORT" ]] || warn "Слушает $lp, а в $AD_STATE записан $PORT"
        PORT=$lp
        [[ -n "$(ss -Hlun "sport = :$lp" 2>/dev/null)" ]] && ok "${lp}/udp слушается" || fail "${lp}/udp не слушается"
    else
        fail "Интерфейса awg0 нет (awg show)"
    fi
    if grep -q '^HeaderProtectionKey' "$SERVER_CONF" 2>/dev/null; then ok "AWG 3.1: HeaderProtectionKey в конфиге"
    else ok "Профиль AWG 2.0"; fi
    [[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" == 1 ]] && ok "IPv4 forwarding включён" || fail "net.ipv4.ip_forward = 0"
    if iptables -t nat -S 2>/dev/null | grep -q MASQUERADE || nft list ruleset 2>/dev/null | grep -q masquerade; then ok "NAT (MASQUERADE) есть"
    else fail "Нет NAT-правила MASQUERADE"; fi
    if ufw status 2>/dev/null | grep -q 'Status: active'; then
        ufw status 2>/dev/null | grep -qE "^${PORT:-x}/udp" && ok "ufw: ${PORT}/udp открыт" || fail "ufw активен, но ${PORT:-?}/udp не разрешён"
        local sp; sp=$(ssh_port)
        ufw status 2>/dev/null | grep -qE "^(${sp}(/tcp)?|OpenSSH)\b" && ok "ufw: SSH ${sp}/tcp открыт" || warn "ufw: не вижу правила для SSH ${sp}/tcp — не закрывай текущую сессию, проверь вход"
    else
        warn "ufw выключен — сервер без фаервола"
    fi
    local n; n=$(awg show awg0 peers 2>/dev/null | grep -c . || true)
    ok "Клиентов (peers): ${n:-0}"
    if awg show awg0 latest-handshakes 2>/dev/null | awk '$2 > 0 {f=1} END {exit !f}'; then ok "Есть рукопожатия клиентов"
    else log "    [..] Рукопожатий пока нет — подключи клиента и запусти: awgctl check"; fi
    PUBLIC_IP=${PUBLIC_IP:-$(detect_ip)}
    external_check
    log ""
    log "Итог: ${FAILS} ошибок, ${WARNS} предупреждений. Подробная проверка установщика: bash $AWG_DIR/manage_amneziawg.sh check"
    ((FAILS == 0))
}

summary() {
    hdr "Готово"
    log "    Сервер:  ${PUBLIC_IP:-?}:${PORT}/udp, AmneziaWG ${PROTOCOL}"
    log "    Пользователи:  awgctl list | awgctl add <имя> [--days N] | awgctl show <имя> | awgctl del <имя>"
    log "    Проверка:      awgctl check        Справка: awgctl help"
    log "    Клиенты для 3.1: AmneziaWG (iOS/macOS 3.1.4+, Android 3.1.4+, Windows 3.1.0+), WG Tunnel 5.6+, Amnezia VPN 5.0.1.5+."
    log "    Роутеры GL.iNet на штатной прошивке и Hiddify 3.1 не понимают — для них отдельный сервер с --protocol=2.0."
}

# ------------------------------------------------------------------ пользователи
need_installed() {
    need_root
    [[ -f "$SERVER_CONF" && -f "$AWG_DIR/manage_amneziawg.sh" ]] || die "AmneziaWG не установлен. Установка: awgctl install"
}
check_name() { [[ "${1:-}" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || die "Имя «${1:-}»: латиница, цифры, _ и -, до 32 символов"; }
client_exists() { grep -qxF "#_Name = $1" "$SERVER_CONF"; }
need_client() { check_name "${1:-}"; client_exists "$1" || die "Пользователя «$1» нет (awgctl list)"; }

peers_tsv() { # имя<TAB>pubkey<TAB>ip — из конфига сервера
    awk '/^\[Peer\]/ {n=""; k=""; next}
         /^#_Name = / {n=substr($0, 10)}
         /^PublicKey = / && n != "" {k=substr($0, 13)}
         /^AllowedIPs = / && n != "" && k != "" {ip=substr($0, 14); sub(/\/.*/, "", ip); print n "\t" k "\t" ip; n=""; k=""}' "$SERVER_CONF"
}
client_ip() { peers_tsv | awk -F'\t' -v n="$1" '$1 == n {print $3; exit}'; }

human() { # байты → «1.2 ГБ»
    awk -v b="${1:-0}" 'BEGIN { split("Б КБ МБ ГБ ТБ", u, " "); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}
ago() { # секунды с эпохи → «5 мин назад»
    local t=${1:-0} d
    ((t > 0)) || { echo "—"; return; }
    d=$(( $(date +%s) - t ))
    if ((d < 120)); then echo "сейчас"
    elif ((d < 3600)); then echo "$((d / 60)) мин назад"
    elif ((d < 86400)); then echo "$((d / 3600)) ч назад"
    else echo "$((d / 86400)) дн назад"; fi
}
expiry_of() { cat "$AWG_DIR/expiry/$1" 2>/dev/null || true; }

is_off() { [[ -f "$OFF_LIST" ]] && grep -qxF "$1" "$OFF_LIST"; }

rules_apply() { # отключённые пользователи: DROP их трафика в туннеле (переживает syncconf и перезапуск awg0)
    local n ip
    iptables -N AWGCTL 2>/dev/null || true
    iptables -F AWGCTL
    if [[ -f "$OFF_LIST" ]]; then
        while IFS= read -r n; do
            [[ -n "$n" ]] || continue
            ip=$(client_ip "$n")
            [[ -n "$ip" ]] && iptables -A AWGCTL -s "$ip" -j DROP
        done <"$OFF_LIST"
    fi
    iptables -C FORWARD -i awg0 -j AWGCTL 2>/dev/null || iptables -I FORWARD 1 -i awg0 -j AWGCTL
    iptables -C INPUT -i awg0 -j AWGCTL 2>/dev/null || iptables -I INPUT 1 -i awg0 -j AWGCTL
    # DNS-блокировщик: все DNS-запросы клиентов — на Blocky (конфиги клиентов не меняются)
    if [[ -s "$AD_DIR/adblock" ]]; then
        local tip; tip=$(cat "$AD_DIR/adblock")
        iptables -t nat -N AWGCTL_DNS 2>/dev/null || true
        iptables -t nat -F AWGCTL_DNS
        iptables -t nat -A AWGCTL_DNS -p udp --dport 53 -j DNAT --to-destination "${tip}:53"
        iptables -t nat -A AWGCTL_DNS -p tcp --dport 53 -j DNAT --to-destination "${tip}:53"
        iptables -t nat -C PREROUTING -i awg0 -j AWGCTL_DNS 2>/dev/null || iptables -t nat -I PREROUTING 1 -i awg0 -j AWGCTL_DNS
    elif iptables -t nat -S AWGCTL_DNS >/dev/null 2>&1; then
        iptables -t nat -D PREROUTING -i awg0 -j AWGCTL_DNS 2>/dev/null || true
        iptables -t nat -F AWGCTL_DNS; iptables -t nat -X AWGCTL_DNS 2>/dev/null || true
    fi
}
rules_persist() { # после перезагрузки и после ufw reload (он сбрасывает встроенные цепочки)
    cat >/etc/systemd/system/awgctl-rules.service <<UNIT
[Unit]
Description=awgctl: правила для отключённых пользователей AmneziaWG
After=awg-quick@awg0.service ufw.service network-online.target

[Service]
Type=oneshot
ExecStart=$AD_BIN _rules

[Install]
WantedBy=multi-user.target
UNIT
    printf '* * * * * root [ -x %s ] && %s _rules >/dev/null 2>&1\n' "$AD_BIN" "$AD_BIN" >/etc/cron.d/awgctl-rules
    systemctl daemon-reload
    systemctl enable awgctl-rules.service >/dev/null 2>&1 || true
}

show_link() {
    local f="$AWG_DIR/$1.vpnuri"
    [[ -s "$f" ]] || manage --yes regen "$1" >/dev/null 2>&1 || true
    [[ -s "$f" ]] && cat "$f" || warn "Ссылки vpn:// нет ($f)"
}

do_add() {
    need_installed
    local n=${POS[0]:-} a=(--yes)
    check_name "$n"
    client_exists "$n" && die "Пользователь «$n» уже есть"
    if [[ -n "$DAYS" ]]; then
        [[ "$DAYS" =~ ^[0-9]+$ ]] && ((DAYS > 0)) || die "--days: целое число дней"
        a+=("--expires=${DAYS}d")
    fi
    ((PSK)) && a+=(--psk)
    manage "${a[@]}" add "$n" >/dev/null || die "Не удалось добавить «$n» (подробности: awgctl engine add $n)"
    log "Добавлен: $n ($(client_ip "$n"))${DAYS:+, на $DAYS дн. — до $(date -d "@$(expiry_of "$n")" '+%d.%m.%Y')}"
    do_show "$n"
}

do_show() {
    need_installed
    local n=${1:-${POS[0]:-}}
    need_client "$n"
    manage qr "$n" || true
    log ""
    log "Ссылка (Amnezia VPN / AmneziaWG → «Вставить из буфера»):"
    show_link "$n"
    log ""
    log "Файл конфига: $AWG_DIR/$n.conf   (QR-картинка: $AWG_DIR/$n.png)"
    is_off "$n" && warn "Пользователь отключён: awgctl on $n"
    return 0
}

do_list() {
    need_installed
    local dump name pk ip hs rx tx st exp exp_s n=0
    dump=$(awg show awg0 dump 2>/dev/null | tail -n +2 || true)
    printf '%-20s %-15s %-8s %10s %10s  %-14s %s\n' "ИМЯ" "IP" "СТАТУС" "СКАЧАЛ" "ОТДАЛ" "ВХОД" "СРОК"
    while IFS=$'\t' read -r name pk ip; do
        [[ -n "$name" ]] || continue
        n=$((n + 1))
        read -r hs rx tx < <(awk -F'\t' -v k="$pk" '$1 == k {print $5, $6, $7; f=1} END {if (!f) print 0, 0, 0}' <<<"$dump")
        exp=$(expiry_of "$name"); exp_s="∞"
        [[ -n "$exp" ]] && exp_s=$(date -d "@$exp" '+%d.%m.%Y' 2>/dev/null || echo "$exp")
        st="вкл"; is_off "$name" && st="ВЫКЛ"
        # клиент скачал = сервер отправил (tx), отдал = сервер получил (rx)
        printf '%-20s %-15s %-8s %10s %10s  %-14s %s\n' "$name" "$ip" "$st" "$(human "$tx")" "$(human "$rx")" "$(ago "$hs")" "$exp_s"
    done < <(peers_tsv)
    log ""
    log "Пользователей: $n. Трафик — с последнего запуска awg0 ($(systemctl show -p ActiveEnterTimestamp --value awg-quick@awg0 2>/dev/null | cut -d' ' -f2-3))."
}

do_renew() {
    need_installed
    local n=${POS[0]:-} d=${POS[1]:-}
    need_client "$n"
    [[ "$d" =~ ^[0-9]+$ ]] || die "Использование: awgctl renew <имя> <дней> (0 — бессрочно)"
    mkdir -p "$AWG_DIR/expiry"
    if ((d == 0)); then
        rm -f "$AWG_DIR/expiry/$n"; log "$n: бессрочно"
    else
        echo $(( $(date +%s) + d * 86400 )) >"$AWG_DIR/expiry/$n"; chmod 600 "$AWG_DIR/expiry/$n"
        [[ -f /etc/cron.d/awg-expiry ]] || warn "Нет /etc/cron.d/awg-expiry — истёкшие не удаляются автоматически (появится после первого add --days)"
        log "$n: до $(date -d "@$(expiry_of "$n")" '+%d.%m.%Y %H:%M') (по истечении пользователь удаляется)"
    fi
}

do_off() {
    need_installed
    local n=${POS[0]:-}
    need_client "$n"
    mkdir -p "$AD_DIR"; touch "$OFF_LIST"; chmod 600 "$OFF_LIST"
    is_off "$n" || echo "$n" >>"$OFF_LIST"
    rules_persist; rules_apply
    log "$n отключён: подключиться может, но трафик не идёт. Включить: awgctl on $n"
}
do_on() {
    need_installed
    local n=${POS[0]:-}
    need_client "$n"
    if [[ -f "$OFF_LIST" ]]; then grep -vxF "$n" "$OFF_LIST" >"$OFF_LIST.tmp" || true; mv -f "$OFF_LIST.tmp" "$OFF_LIST"; fi
    rules_apply
    log "$n включён"
}

do_uninstall() {
    need_root
    if ((!AUTO_YES)) && [[ -r /dev/tty ]]; then
        local a; read -rp "Удалить AmneziaWG со всеми пользователями? (бэкап движок сделает сам) [y/N] " a </dev/tty
        [[ "$a" =~ ^([Yy]|да|д)$ ]] || die "Отменено"
    fi
    [[ -f "$AD_DIR/install_amneziawg.sh" ]] || fetch_installer
    env -u AWG_BRANCH bash "$AD_DIR/install_amneziawg.sh" --uninstall --yes || warn "Движок завершил удаление с ошибкой — см. вывод выше"
    resume_unit_off
    systemctl disable awgctl-rules.service >/dev/null 2>&1 || true
    iptables -D FORWARD -i awg0 -j AWGCTL 2>/dev/null || true
    iptables -D INPUT -i awg0 -j AWGCTL 2>/dev/null || true
    iptables -F AWGCTL 2>/dev/null || true; iptables -X AWGCTL 2>/dev/null || true
    if [[ -f /etc/systemd/system/blocky.service ]]; then
        systemctl disable --now blocky >/dev/null 2>&1 || true
        rm -rf /etc/systemd/system/blocky.service /opt/blocky /usr/local/bin/blocky
        userdel blocky 2>/dev/null || true
    fi
    iptables -t nat -D PREROUTING -i awg0 -j AWGCTL_DNS 2>/dev/null || true
    iptables -t nat -F AWGCTL_DNS 2>/dev/null || true; iptables -t nat -X AWGCTL_DNS 2>/dev/null || true
    command -v awgram-setup >/dev/null && log "    Telegram-бот остался: удалить — awgram-setup uninstall --purge"
    rm -rf "$AD_DIR" /etc/cron.d/awgctl-rules /etc/systemd/system/awgctl-rules.service "$AD_BIN"
    systemctl daemon-reload || true
    log "AmneziaWG и awgctl удалены."
}

do_del() {
    need_installed
    local n=${POS[0]:-}
    need_client "$n"
    if ((!AUTO_YES)) && [[ -r /dev/tty ]]; then
        local a; read -rp "Удалить «$n»? Его конфиг перестанет работать. [y/N] " a </dev/tty
        [[ "$a" =~ ^([Yy]|да|д)$ ]] || die "Отменено"
    fi
    manage --yes remove "$n" >/dev/null || die "Не удалось удалить «$n» (awgctl engine remove $n)"
    if [[ -f "$OFF_LIST" ]]; then grep -vxF "$n" "$OFF_LIST" >"$OFF_LIST.tmp" || true; mv -f "$OFF_LIST.tmp" "$OFF_LIST"; rules_apply; fi
    log "Удалён: $n"
}

# ------------------------------------------------------------------ дополнения: DNS-блокировщик рекламы
tunnel_ip() { ip -4 -o addr show dev awg0 2>/dev/null | awk '{print $4; exit}' | cut -d/ -f1; }

fetch_pinned() { # fetch_pinned <url> <куда> <sha256>
    curl -fsSL --max-time 120 -o "$2.new" "$1" || { rm -f "$2.new"; return 1; }
    [[ "$(sha256sum "$2.new" | awk '{print $1}')" == "$3" ]] || { rm -f "$2.new"; warn "SHA256 не совпал: $1"; return 1; }
    mv -f "$2.new" "$2"
}

adblock_on() {
    need_installed
    hdr "DNS-блокировщик рекламы (Blocky v${BLOCKY_VER} + списки Hagezi)"
    local tip arch sha tmp f name want
    tip=$(tunnel_ip); [[ -n "$tip" ]] || die "Интерфейс awg0 не поднят — нечего защищать"
    case "$(uname -m)" in
        x86_64) arch=x86_64; sha=$BLOCKY_SHA256_X86_64 ;;
        aarch64) arch=arm64; sha=$BLOCKY_SHA256_ARM64 ;;
        *) die "Blocky: архитектура $(uname -m) не поддерживается" ;;
    esac
    tmp=$(mktemp -d)
    if ! /usr/local/bin/blocky version 2>/dev/null | grep -q "$BLOCKY_VER"; then
        fetch_pinned "https://github.com/0xERR0R/blocky/releases/download/v${BLOCKY_VER}/blocky_v${BLOCKY_VER}_Linux_${arch}.tar.gz" "$tmp/b.tgz" "$sha" \
            || { rm -rf "$tmp"; die "Не удалось скачать Blocky"; }
        tar -xzf "$tmp/b.tgz" -C "$tmp" blocky && install -m 0755 "$tmp/blocky" /usr/local/bin/blocky
    fi
    ok "Blocky v${BLOCKY_VER} (SHA256 совпал)"
    for f in $ADBLOCK_FILES; do
        name=${f%%:*}; want=${f#*:}
        fetch_pinned "$ADBLOCK_REPO/$name" "$tmp/$name" "$want" || { rm -rf "$tmp"; die "Не удалось скачать $name"; }
        sed -i 's/\r$//' "$tmp/$name"
    done
    id blocky >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin blocky
    mkdir -p /opt/blocky/lists
    install -m 0644 "$tmp/config.yml" /opt/blocky/config.yml
    install -m 0644 "$tmp/custom-deny.txt" /opt/blocky/custom-deny.txt
    install -m 0644 "$tmp/blocky.service" /etc/systemd/system/blocky.service
    rm -rf "$tmp"
    sed -i "s/10\.9\.9\.1:53/${tip//./\\.}:53/g" /opt/blocky/config.yml
    chown -R blocky:blocky /opt/blocky
    systemctl daemon-reload
    systemctl enable --now blocky >/dev/null 2>&1 || true
    systemctl restart blocky
    sleep 3
    systemctl is-active --quiet blocky || { journalctl -u blocky -n 20 --no-pager; die "Blocky не запустился"; }
    ok "Blocky слушает ${tip}:53 (только внутри туннеля)"
    if ufw status 2>/dev/null | grep -q 'Status: active'; then
        ufw allow in on awg0 to any port 53 proto udp comment 'awgctl adblock' >/dev/null
        ufw allow in on awg0 to any port 53 proto tcp comment 'awgctl adblock' >/dev/null
        ok "ufw: 53/udp+tcp открыт только на awg0"
    fi
    mkdir -p "$AD_DIR"; echo "$tip" >"$AD_DIR/adblock"
    rules_persist; rules_apply
    ok "DNS-запросы всех клиентов перенаправлены на Blocky — переимпортировать конфиги не нужно"
    log "    Списки скачиваются 1–2 минуты. Проверка: awgctl adblock status"
    log "    Не блокирует рекламу внутри YouTube и сайты с DNS-over-HTTPS в браузере (выключи «Безопасный DNS»)."
}

adblock_off() {
    need_installed
    rm -f "$AD_DIR/adblock"
    rules_apply
    systemctl disable --now blocky >/dev/null 2>&1 || true
    ufw delete allow in on awg0 to any port 53 proto udp >/dev/null 2>&1 || true
    ufw delete allow in on awg0 to any port 53 proto tcp >/dev/null 2>&1 || true
    log "Блокировщик выключен: DNS клиентов снова идёт как в их конфигах. Включить: awgctl adblock on"
}

adblock_status() {
    need_installed
    if [[ ! -f "$AD_DIR/adblock" ]]; then log "Блокировщик выключен. Включить: awgctl adblock on"; return 0; fi
    WARNS=0; FAILS=0
    systemctl is-active --quiet blocky && ok "Blocky работает" || fail "Blocky не работает (journalctl -u blocky)"
    local tip; tip=$(cat "$AD_DIR/adblock")
    [[ -n "$(ss -Hlun "src $tip:53" 2>/dev/null)" ]] && ok "Слушает ${tip}:53" || fail "Ничего не слушает ${tip}:53"
    iptables -t nat -S AWGCTL_DNS 2>/dev/null | grep -q DNAT && ok "DNS клиентов перенаправлен" || fail "Нет перенаправления DNS (awgctl adblock on)"
    local st; st=$(curl -fsS --max-time 5 http://127.0.0.1:4000/api/blocking/status 2>/dev/null || true)
    [[ "$st" == *'"enabled":true'* ]] && ok "Блокировка включена (API Blocky)" || warn "API Blocky не ответил или блокировка выключена: ${st:-нет ответа}"
    if command -v dig >/dev/null; then
        [[ "$(dig +short -4 @"$tip" doubleclick.net A 2>/dev/null | head -1)" == 0.0.0.0 ]] && ok "doubleclick.net блокируется" || warn "doubleclick.net пока не блокируется (списки ещё качаются?)"
    fi
}

do_adblock() {
    case "${POS[0]:-on}" in
        on) adblock_on ;;
        off) adblock_off ;;
        status) adblock_status ;;
        *) die "awgctl adblock on|off|status" ;;
    esac
}

# ------------------------------------------------------------------ дополнения: Telegram-бот awgram
do_bot() {
    need_installed
    hdr "Telegram-бот awgram ${AWGRAM_VER}"
    if [[ -z "$TG_TOKEN" ]]; then
        [[ -r /dev/tty ]] || die "Нужен токен бота: AWGRAM_TOKEN=… awgctl bot --tg-admins=ID"
        read -rsp "    Токен бота от @BotFather (ввод скрыт): " TG_TOKEN </dev/tty; echo
    fi
    if [[ -z "$TG_ADMINS" ]]; then
        [[ -r /dev/tty ]] || die "Нужен Telegram ID: --tg-admins=ID"
        read -rp "    Твой Telegram ID (от @userinfobot; несколько — через запятую): " TG_ADMINS </dev/tty
    fi
    [[ "$TG_TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]] || die "Токен не похож на токен бота (вида 123456:ABC…)"
    [[ "$TG_ADMINS" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "Telegram ID — числа через запятую"
    local f="$AD_DIR/awgram-install.sh"
    mkdir -p "$AD_DIR"
    fetch_pinned "https://github.com/ekuraev/awgram/releases/download/${AWGRAM_VER}/install.sh" "$f" "$AWGRAM_SETUP_SHA256" \
        || die "Не удалось скачать установщик awgram"
    # токен — через окружение: не попадает в ps и историю shell
    AWGRAM_TOKEN="$TG_TOKEN" bash "$f" install --lang ru --mode hardened --admins "$TG_ADMINS" --version "$AWGRAM_VER" --yes \
        || die "Установка awgram не удалась (подробности выше)"
    ok "Бот установлен (режим hardened). Напиши своему боту /start в Telegram"
    log "    Управление ботом: awgram-setup status | update | config | uninstall"
    log "    Токен даёт полный контроль над VPN — не пересылай его."
}

ask_extras() { # в начале установки: после перезагрузок спросить уже не у кого
    [[ -r /dev/tty && -t 0 ]] || { WANT_ADBLOCK=${WANT_ADBLOCK:-0}; WANT_BOT=${WANT_BOT:-0}; return 0; }
    hdr "Дополнения (ставятся в конце установки)"
    local a
    if [[ -z "$WANT_ADBLOCK" ]]; then
        read -rp "    Блокировать рекламу и трекеры по DNS для всех клиентов (Blocky)? [y/N] " a </dev/tty
        [[ "$a" =~ ^([Yy]|да|д)$ ]] && WANT_ADBLOCK=1 || WANT_ADBLOCK=0
    fi
    if [[ -z "$WANT_BOT" ]]; then
        read -rp "    Поставить Telegram-бот awgram для управления пользователями? [y/N] " a </dev/tty
        [[ "$a" =~ ^([Yy]|да|д)$ ]] && WANT_BOT=1 || WANT_BOT=0
    fi
    if [[ "$WANT_BOT" == 1 ]]; then
        [[ -n "$TG_TOKEN" ]] || { read -rsp "    Токен бота от @BotFather (ввод скрыт): " TG_TOKEN </dev/tty; echo; }
        [[ -n "$TG_ADMINS" ]] || read -rp "    Твой Telegram ID (от @userinfobot): " TG_ADMINS </dev/tty
        [[ "$TG_TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]] || die "Токен не похож на токен бота (вида 123456:ABC…)"
        [[ "$TG_ADMINS" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "Telegram ID — числа через запятую"
    fi
}

install_extras() {
    if [[ "${WANT_ADBLOCK:-0}" == 1 ]]; then ( adblock_on ) || warn "Блокировщик не поставился — повтори: awgctl adblock on"; fi
    if [[ "${WANT_BOT:-0}" == 1 ]]; then ( do_bot ) || warn "Бот не поставился — повтори: awgctl bot"; fi
    # токен больше не нужен в файле состояния
    if [[ -n "${TG_TOKEN:-}" ]]; then TG_TOKEN=""; [[ -f "$AD_STATE" ]] && state_save; fi
}

do_install() {
    need_root
    mkdir -p "$(dirname "$AD_LOG")"; touch "$AD_LOG"; chmod 600 "$AD_LOG"
    log "awgctl v${AD_VERSION} ($(date '+%F %T'))"
    case "$PROTOCOL" in 3.1|2.0) ;; *) die "--protocol: 3.1 или 2.0" ;; esac
    if [[ -n "$SRV_NAME" ]]; then
        [[ ${#SRV_NAME} -le 64 && "$SRV_NAME" != *[\"\'\\]* && ! "$SRV_NAME" =~ [[:cntrl:]] ]] || die "--name: до 64 символов, без кавычек и обратной косой черты"
    fi
    command -v jq >/dev/null || { DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null 2>&1 || { apt-get update -qq >/dev/null 2>&1; DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null 2>&1; } || die "Не удалось поставить jq"; }
    preflight
    ((DRY_RUN)) || ask_extras

    hdr "План"
    installer_args
    log "    1. Скачать install_amneziawg.sh v${ENGINE_VER} (bivlked, проверка SHA256) в $AD_DIR"
    log "    2. Запустить: install_amneziawg.sh ${INST_ARGS[*]}"
    log "       — обновит систему, подключит официальный PPA Amnezia (ключ сверяется по отпечатку),"
    log "         соберёт модуль через DKMS, включит ufw (SSH $(ssh_port)/tcp + ${PORT}/udp), fail2ban, NAT;"
    if [[ "$KEEP_PKGS" == 1 ]]; then log "       — системные пакеты сохраняются (--keep-packages)"
    else log "       — удалит лишние службы (snapd, packagekit, modemmanager, udisks2, unattended-upgrades…) — как советует автор для 1 ГБ RAM"; fi
    if [[ "$KEEP_IPV6" == 1 ]]; then log "       — IPv6 на хосте оставит (--keep-ipv6)"; else log "       — отключит IPv6 на хосте"; fi
    log "       — 1–2 перезагрузки: после них установка продолжится сама (systemd awgctl-resume)."
    log "       — имя сервера в приложении: ${SRV_NAME:-AWG Server (по умолчанию движка)}"
    log "    3. Клиенты: ${CLIENTS:-my_phone, my_laptop (по умолчанию установщика)}"
    log "    4. Дополнения: блокировщик рекламы — $([[ "${WANT_ADBLOCK:-0}" == 1 ]] && echo да || echo нет), Telegram-бот — $([[ "${WANT_BOT:-0}" == 1 ]] && echo да || echo нет)"
    log "    5. Итоговая проверка. Лог: $AD_LOG"
    if ((DRY_RUN)); then log ""; log "--dry-run: ничего не изменено."; exit 0; fi

    state_save
    self_install
    fetch_installer
    resume_unit_on
    local rc=0; run_installer || rc=$?
    case $rc in
        0) finish ;;
        2) log ""; log "Сервер перезагружается. Установка продолжится сама; через 3–5 минут зайди по SSH и выполни: awgctl status" ;;
        *) resume_unit_off; die "install_amneziawg.sh завершился с ошибкой ($rc). Лог: $AWG_DIR/install_amneziawg.log. Повторить: awgctl resume" ;;
    esac
}

do_resume() {
    need_root
    state_load || die "Нет $AD_STATE — нечего продолжать. Новая установка: awgctl install"
    log "Продолжение установки ($(date '+%F %T'))"
    # после перезагрузки сеть может подняться не сразу
    for _ in $(seq 1 30); do getent hosts github.com >/dev/null && break; sleep 2; done
    [[ -f "$AD_DIR/install_amneziawg.sh" ]] || fetch_installer
    local rc=0; run_installer || rc=$?
    case $rc in
        0) finish ;;
        2) log "Ещё одна перезагрузка — продолжу после неё." ;;
        *) resume_unit_off; log "install_amneziawg.sh: ошибка ($rc). Лог: $AWG_DIR/install_amneziawg.log. Повторить: awgctl resume"; exit "$rc" ;;
    esac
}

finish() {
    resume_unit_off
    setup_clients
    install_extras
    post_check || true
    summary
    echo "done $(date '+%F %T')" >"$AD_DIR/finished"
}

do_status() {
    if [[ -f "$AD_DIR/finished" ]]; then log "Установка завершена: $(cut -d' ' -f2- "$AD_DIR/finished")"; post_check || true; return; fi
    if systemctl is-enabled --quiet awgctl-resume.service 2>/dev/null; then
        log "Установка ещё идёт (шаг установщика: $(cat "$AWG_DIR/setup_state" 2>/dev/null || echo ?)). Последние строки лога:"
        tail -n 15 "$AD_LOG" 2>/dev/null || true
    else
        log "Установка не запущена или прервана. Лог: $AD_LOG; продолжить: awgctl resume"
        tail -n 15 "$AD_LOG" 2>/dev/null || true
    fi
}

# при подключении через source (тесты) — только функции
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "$CMD" in
    help) usage ;;
    install) do_install ;;
    resume) do_resume ;;
    status) need_root; do_status ;;
    check) need_root; post_check ;;
    add) do_add ;;
    list|ls) do_list ;;
    show) do_show "${POS[0]:-}" ;;
    qr) need_installed; need_client "${POS[0]:-}"; manage qr "${POS[0]}" ;;
    link) need_installed; need_client "${POS[0]:-}"; show_link "${POS[0]}" ;;
    conf) need_installed; need_client "${POS[0]:-}"; cat "$AWG_DIR/${POS[0]}.conf" ;;
    renew) do_renew ;;
    off) do_off ;;
    on) do_on ;;
    del|rm|remove) do_del ;;
    backup) need_installed; manage --yes backup ;;
    restore) need_installed; manage restore "${POS[@]}" ;;
    engine) need_installed; manage "${EXTRA[@]+"${EXTRA[@]}"}" ;;
    uninstall) do_uninstall ;;
    adblock) do_adblock ;;
    bot) do_bot ;;
    _rules) [[ -f "$SERVER_CONF" ]] && rules_apply ;;
    *) die "Неизвестная команда: $CMD (awgctl help)" ;;
esac
