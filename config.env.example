# Переменные amneziawg-autodeploy (autodeploy.sh). Секретов здесь нет и быть не должно.
# Использование:  set -a; . ./config.env; set +a; bash autodeploy.sh --yes
# Любую переменную можно задать и флагом (см. bash autodeploy.sh --help).

# UDP-порт AmneziaWG. Пусто — случайный 20000–59999 (не 39743 по умолчанию установщика).
PORT=
# 1 — порт 443/udp и пресет mobile (мобильные операторы реже режут 443/udp как QUIC).
MOBILE=0
# Поколение протокола: 3.1 (по умолчанию) или 2.0 (роутеры GL.iNet на штатной прошивке, Hiddify).
PROTOCOL=3.1
# Адрес для клиентов, если сервер за NAT или нужен домен: FQDN, IPv4 или [IPv6]. Пусто — авто.
ENDPOINT=
# Клиенты через запятую (латиница, цифры, _ и -). Пусто — my_phone и my_laptop установщика.
CLIENTS=phone,laptop
# 1 — ставить, даже если IP недоступен из России (по данным check-host.net).
ALLOW_BLOCKED=0
# 1 — не проверять IP через check-host.net.
SKIP_EXTERNAL_CHECK=0
# Откуда брать install_amneziawg.sh (проверяется по SHA256 из autodeploy.sh).
AD_REF=main
